# OpenWeatherMap (opcional) - sem chave, o clima degrada para "sem chuva"
OPENWEATHER_API_KEY=
OPENWEATHER_LAT=-23.5505
OPENWEATHER_LON=-46.6333
OPENWEATHER_UNITS=metric
OPENWEATHER_LANG=pt_br

# InfluxDB (opcional) - sem o pacote/servico, a persistencia vira no-op
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=minha_planta
INFLUXDB_BUCKET=processo_bayer